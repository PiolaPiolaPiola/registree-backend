				{
					"name": "Registro",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 201', () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"pm.test('Siempre se crea con rol USER', () => pm.expect(json.user.role).to.eql('USER'));",
