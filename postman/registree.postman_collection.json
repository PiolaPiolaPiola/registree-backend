{
	"info": {
		"_postman_id": "09037472-ba9f-48d1-ac39-74c2e2d5f7a7",
		"name": "Registree API",
		"description": "API REST de Registree (inventario y dashboard de productos).\n\n1. Importar también el entorno `registree.postman_environment.json` y seleccionarlo.\n2. Levantar la API (`npm run dev`) y crear los usuarios de prueba (`npm run seed`).\n3. Ejecutar **Auth → Login ADMIN** (guarda el token) o correr toda la colección con el Collection Runner.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"description": "Login y registro. Ejecutar primero \"Login ADMIN\": guarda el token que usa el resto de la colección.",
			"item": [
				{
					"name": "Login ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"pm.test('Devuelve token y usuario sin contraseña', () => {",
									"  pm.expect(json.token).to.be.a('string');",
									"  pm.expect(json.user).to.not.have.property('password');",
									"});",
									"pm.environment.set('token', json.token);",
									"pm.environment.set('adminId', json.user._id);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@registree.com\",\n  \"password\": \"Admin12345\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión con el usuario ADMIN del seed y guarda el token en la variable `token`."
					}
				},
				{
					"name": "Login USER",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.environment.set('userToken', pm.response.json().token);"
								]
							}
						}
					],
					"request": {
						"auth": {
