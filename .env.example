# Puerto del servidor
PORT=3000

MONGO_ROOT_USER=registree_admin
MONGO_ROOT_PASSWORD=cambiar_contrasena

# Cadena de conexión a MongoDB (contenedor Docker)
MONGO_URI=mongodb://registree_admin:cambiar_contrasena@localhost:27017/registree?authSource=admin

# Configuración de JWT
JWT_SECRET=secreto
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10